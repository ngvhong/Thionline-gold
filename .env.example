# Sao chép file này thành .env.local (hoặc .env.production trên VPS) rồi điền giá trị thật.
# NEXT_PUBLIC_* (nếu có) phải có TRƯỚC khi chạy `npm run build`.

# --- Bắt buộc ---
MONGODB_URI=
JWT_SECRET=

# --- Địa chỉ công khai thật của app (bắt buộc khi chạy sau reverse proxy,
# ví dụ Coolify/Traefik) — dùng để dựng link trong email (xác nhận email,
# đặt lại mật khẩu...). KHÔNG có dấu / ở cuối.
# Ví dụ: https://thi.tenmiencuaban.com  hoặc  http://xxxx.103.74.103.151.sslip.io
APP_URL=

# --- Cloudinary (lưu ảnh) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gửi email (Gmail App Password) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Thionline-opal

# --- Dịch vụ xuất PDF / Word (Hugging Face Space) ---
EXPORT_PDF_SERVICE_URL=
EXPORT_DOCX_SERVICE_URL=
EXPORT_SERVICE_SECRET=
